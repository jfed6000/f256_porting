# env.sh.example - your machine's paths, for the guide (README.md, "Your machine") and starter/.
# Copy it to env.sh (git ignores that), set each line, and source it:  . ./env.sh
export NITROS9DIR=$HOME/src/nitros9                          # the NitrOS-9 tree (nitros9project/nitros9, main)
export LWASM=lwasm                                           # the assembler (LWTOOLS)
export MAMEDIR=$HOME/src/mame                                # the Wildbits MAME, built (github.com/rlucente-retro/mame)
export F256_ROMS=$HOME/src/mame/roms                         # the ROMs MAME's wbjr2 machine needs
export F256_IMAGE=$HOME/src/nitros9/recipes/wildbits/l2/l2_wildbitsjr2.dsk   # a bootable Level 2 image for the Jr2
export ARCADE_MAME=/usr/games/mame                           # a stock MAME, for arcade originals (section 14a)
export FPGADIR=$HOME/src/fpga-6809-cores-staging             # a read-only clone of the FPGA core (the RTL)
